# ── Core ─────────────────────────────────────────────
# Canonical production URL — keep the existing official domain.
NEXT_PUBLIC_SITE_URL="https://faventmagna.com"

# PostgreSQL (Render / Neon / Supabase / local)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/faventmagna?schema=public"

# ── Admin auth ───────────────────────────────────────
# Generate with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
# Used only by `npm run db:seed` / `npm run admin:create` to create the first super admin
SEED_ADMIN_EMAIL="admin@faventmagna.com"
SEED_ADMIN_PASSWORD="change-me-to-a-strong-password"
SEED_ADMIN_NAME="Site Administrator"

# ── Cloudinary (media library) ───────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="faventmagna"

# ── Resend (transactional email) ─────────────────────
RESEND_API_KEY=""
# Must be a sender on a domain verified in Resend (e.g. faventmagna.com)
EMAIL_FROM="Favent Magna <no-reply@faventmagna.com>"
# Where new enquiry notifications go (comma-separated for several)
ENQUIRY_NOTIFY_EMAIL="info@faventmagna.com"
